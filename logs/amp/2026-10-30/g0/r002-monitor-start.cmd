( i=0; dmesg > /tmp/amp-r002-dmesg-before.txt; while [ "$i" -le 20 ]; do printf "SAMPLE %s " "$i"; cat /proc/uptime; cat /sys/bus/platform/devices/core3-heartbeat/status || exit 1; printf "CPU_ONLINE "; cat /sys/devices/system/cpu/online; i=$((i+1)); if [ "$i" -le 20 ]; then sleep 30; fi; done; dmesg > /tmp/amp-r002-dmesg-after.txt; printf "COEXIST_600S_COMPLETE\n" ) > /tmp/amp-r002-coexist.txt 2>&1 & echo MONITOR_PID=$!