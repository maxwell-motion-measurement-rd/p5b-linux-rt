cat /proc/uptime; for phase in idle cpu mem; do if test -d /tmp/amp-g5/$phase; then printf "PHASE %s\n" "$phase"; test ! -f /tmp/amp-g5/$phase/exit-code || cat /tmp/amp-g5/$phase/exit-code; tail -n 2 /tmp/amp-g5/$phase-runner.txt; for mode in forward reverse cross; do test ! -f /tmp/amp-g5/$phase/$mode-progress.txt || tail -n 1 /tmp/amp-g5/$phase/$mode-progress.txt; done; fi; done; cat /sys/bus/platform/devices/core3-heartbeat/stats; grep '^cpu' /proc/stat; grep MemAvailable /proc/meminfo; ps | grep '[g]5_load'