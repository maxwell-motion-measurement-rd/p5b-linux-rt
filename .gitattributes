*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.config text eol=lf
*.dts text eol=lf
*.its text eol=lf
*.sha256 text eol=lf
# Preserve the exact bytes used to verify upstream patches.
*.patch -text
*.diff -text
*.bundle -text
# Keep original serial captures byte-for-byte, including line endings.
logs/board/**/*.txt -text

# Preserve all risk-assessment evidence bytes for SHA-256 verification.
logs/rt-risk/** -text

logs/rt-diagnostics/** -text
